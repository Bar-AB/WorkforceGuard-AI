# Copy to .env.mcp and change the password. Never commit .env.mcp.
# The only file the MCP server reads. The password must be 16-128 characters from
# A-Z a-z 0-9 . _ ~ -. Run make mcp-user after any change to it.
MCP_DATABASE_URL=postgresql+asyncpg://mcp_server:change-me-mcp-password@localhost:5432/workforceguard
# The one company the MCP server serves (a companies.id UUID; run make seed first).
MCP_COMPANY_ID=
